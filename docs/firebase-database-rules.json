{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && ((data.exists() && newData.child('username').val() === data.child('username').val() && (root.child('users').child(auth.uid).child('username').val() === 'nova_infinity' || (newData.child('premium').val() === data.child('premium').val() && newData.child('premiumGiftedBy').val() === data.child('premiumGiftedBy').val() && newData.child('premiumGiftedAt').val() === data.child('premiumGiftedAt').val()))) || (!data.exists() && newData.child('username').val() !== 'nova_infinity' && !newData.child('premium').exists() && !newData.child('premiumGiftedBy').exists() && !newData.child('premiumGiftedAt').exists()))",
        "premium": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('username').val() === 'nova_infinity'"
        },
        "premiumGiftedBy": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('username').val() === 'nova_infinity'"
        },
        "premiumGiftedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('username').val() === 'nova_infinity'"
        }
      }
    },
    "usernameIndex": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((auth.uid === newData.val() && $username !== 'nova_infinity') || (!newData.exists() && data.val() === auth.uid) || ($username === 'nova_infinity' && data.val() === auth.uid && newData.val() === auth.uid))"
      }
    },
    "friendRequests": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$senderUid": {
          ".read": "auth != null && (auth.uid === $recipientUid || auth.uid === $senderUid)",
          ".write": "auth != null && (auth.uid === $senderUid || auth.uid === $recipientUid)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).val() === true) || data.child('members').child(auth.uid).val() === true)"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('chats').child($chatId).child('members').child(auth.uid).val() === true)"
        }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        "$messageId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && newData.child('senderUid').val() === auth.uid"
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('members').child(auth.uid).val() === true) || data.child('members').child(auth.uid).val() === true)"
      }
    },
    "callInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || newData.child('callerUid').val() === auth.uid || data.child('callerUid').val() === auth.uid)"
        }
      }
    }
  }
}
