
{
  "name": "nova-messenger",
  "version": "1.0.0",
  "description": "NOVA Messenger for Windows",
  "main": "main.js",
  "author": "NOVA",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "firebase": "^12.4.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.2.0",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "com.nova.messenger",
    "productName": "NOVA Messenger",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ]
  }
}

